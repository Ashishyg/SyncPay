PORT=3000
NODE_ENV=development
DB_PATH=./db/syncpay.db
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_random_64_hex_chars

# ── OTP + payment alerts over WhatsApp (Baileys). false = mock OTP 123456 (dev only) ──
# After starting, open http://localhost:3000/whatsapp on the server and scan the QR with
# WhatsApp → Linked devices. Use a SPARE number (unofficial API, can be banned).
WHATSAPP_ENABLED=false
