PORT=3000
NODE_ENV=development
DB_PATH=./db/syncpay.db
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_random_64_hex_chars

# ── OTP channel (first one configured wins; none = mock code 123456, dev only) ──
# WhatsApp via Baileys: on first start, scan the QR printed in the terminal with
# WhatsApp → Linked devices. Use a SPARE number (unofficial API, can be banned).
WHATSAPP_ENABLED=false
# Twilio Verify (SMS)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_VERIFY_SID=YOUR_TWILIO_VERIFY_SID

# ── SMS sync (offline phones text signed payments to a gateway phone) ──
# Same value as "Signing Key" in SMS Gateway for Android → Settings → Webhooks.
SMS_WEBHOOK_SIGNING_KEY=
